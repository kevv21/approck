<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Siempre oscuro, como la app: sin destellos blancos al abrir. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/panel</item>
        <item name="colorPrimaryDark">@color/panel</item>
        <item name="colorAccent">@color/acento</item>
        <item name="android:windowBackground">@color/fondo</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/panel</item>
        <item name="android:navigationBarColor">@color/panel</item>
    </style>

    <!-- Arranque: fondo de la app y el ícono al centro. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fondo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
