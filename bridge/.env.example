# Mismos valores que la app web (Project Settings -> API en Supabase)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Puerto serial de la impresora.
#   Windows: el que crea el emparejamiento Bluetooth, p.ej. COM5
#            (Configuracion > Bluetooth > Mas opciones > Puertos COM, el SALIENTE)
#   Linux:   /dev/rfcomm0  (despues de `rfcomm bind`)
#   macOS:   /dev/tty.PT-210-SerialPort
PUERTO=COM5

# 9600 es lo que traen casi todas las PT-210. Si sale basura, probar 115200.
BAUDIOS=9600

# Cada cuanto consultar la cola, en milisegundos.
INTERVALO=3000

# Sin impresora conectada: escribe los tickets en ./salida/ en vez de imprimir.
# Sirve para probar el circuito completo antes de tener el hardware.
SIMULAR=false
