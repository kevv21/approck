# Supabase: crea un proyecto gratis en https://supabase.com y copia estos dos
# valores desde Project Settings -> API.
#
# OJO al desplegar: si creas la variable en Vercel y la dejas EN BLANCO, es
# peor que no crearla. Mejor no declararla hasta tener el valor real.
#
# Sin estos dos valores la app NO simula nada: la caja avisa que falta la base
# y manda a /configuracion, que dice exactamente que falta.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# La Publishable key (sb_publishable_...). Reemplaza a la anon, que
# Supabase deprecia a finales de 2026. El NOMBRE de la variable se queda
# como esta; solo cambia el valor. NUNCA la Secret ni la service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# PIN de acceso al modulo de cierres (solo admin). Cambialo.
NEXT_PUBLIC_PIN_ADMIN=2468

# Sentry (opcional). Sin DSN la app funciona igual y los errores van a consola.
# Para activarlo: npm i @sentry/nextjs y poner el DSN acá.
NEXT_PUBLIC_SENTRY_DSN=
