# Supabase: crea un proyecto gratis en https://supabase.com y copia estos dos valores
# desde Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# PIN de acceso al modulo de cierres (solo admin). Cambialo.
NEXT_PUBLIC_PIN_ADMIN=2468

# Sentry (opcional). Sin DSN la app funciona igual y los errores van a consola.
# Para activarlo: npm i @sentry/nextjs y poner el DSN acá.
NEXT_PUBLIC_SENTRY_DSN=
